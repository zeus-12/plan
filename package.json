{
  "name": "plan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @plan/web dev",
    "dev:desktop": "pnpm --filter @plan/desktop dev",
    "build:web": "pnpm --filter @plan/web build",
    "build:desktop": "pnpm --filter @plan/desktop build",
    "typecheck": "pnpm --filter @plan/web run typecheck && pnpm --filter @plan/desktop run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "format": "pnpm -r --if-present run format",
    "format:check": "pnpm -r --if-present run format:check",
    "release": "bash scripts/release.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  }
}
