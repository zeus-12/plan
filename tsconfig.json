{
  "compilerOptions": {
    "target": "ES2017",
    "strict": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [],
  "references": [
    { "path": "shared" },
    { "path": "apps/web" },
    { "path": "apps/desktop" },
    // The desktop app's main/preload process is a separate tsconfig; list it so
    // the editor owns src/main/** with the right project (resolving @types/node
    // etc.) instead of an inferred project. This solution file is editor-only —
    // the per-package `tsc -p` typecheck scripts never load it, so the
    // non-composite reference is fine here (it would error under `tsc -p`).
    { "path": "apps/desktop/tsconfig.node.json" },
    // Same deal for test/**: it sits outside both src projects, so without this
    // the editor falls back to an inferred project with no `paths` and every
    // `@/…` import in a test reads as unresolved.
    { "path": "apps/desktop/tsconfig.test.json" }
  ]
}
