{
  "name": "@plan/desktop",
  "version": "0.3.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:renderer",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w node-pty",
    "pack": "electron-vite build && electron-builder --mac",
    "pack:dmg": "electron-vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@lexical/react": "^0.45.0",
